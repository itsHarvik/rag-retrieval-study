# Python cache files (auto-generated when Python runs your code)
__pycache__/
*.pyc

# Virtual environments (installed packages; can be recreated)
venv/
.venv/
env/

# Secrets (API keys, passwords)
.env

# IDE settings (PyCharm)
.idea/

# PDFs (download the test paper yourself, see README)
*.pdf

# Private working notes and scratch scripts (kept locally, not published)
CLAUDE.md
LEARNING.md
testing.py
